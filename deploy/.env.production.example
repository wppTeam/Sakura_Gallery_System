# 视觉百花 生产环境配置模板
# 复制为 .env 并填入真实值；真实值不提交仓库
# 视觉百花 生产环境配置
# 复制到服务器: /opt/sakura_gallery/backend/.env

# ==================== 应用基础配置 ====================
APP_NAME="视觉百花"
APP_VERSION="1.0.0"
DEBUG=false

# ==================== 安全配置 ====================
SECRET_KEY=<generate-a-long-random-secret>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 数据库配置 (PostgreSQL) ====================
DATABASE_URL=postgresql+asyncpg://<db-user>:<db-password>@127.0.0.1:5432/<db-name>

# ==================== 文件存储配置 (S3 / MinIO) ====================
STORAGE_BACKEND=s3
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=20971520
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=<bucket>
S3_ACCESS_KEY=<minio-access-key>
S3_SECRET_KEY=<minio-secret-key>
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PRESIGN_EXPIRE_SECONDS=600

# ==================== AI 服务配置 ====================
# 生产服务器暂无 GPU/VLM，AI 分析功能关闭
AI_ENABLED=false
AI_PROVIDER=openai_compatible
AI_TIMEOUT=180
AI_MAX_RETRIES=1
AI_DAILY_BUDGET=1000

# ==================== CORS 配置 ====================
ALLOWED_ORIGINS='["https://<your-domain>"]'
