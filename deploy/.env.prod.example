# =============================================================================
# 视觉百花 Sakura Gallery — 2c4g 生产环境变量模板
# -----------------------------------------------------------------------------
# 用法：
#   cp deploy/.env.prod.example deploy/.env.prod
#   chmod 600 deploy/.env.prod
#   把所有 CHANGE_ME / your-... 换成真实值（密钥用下面的命令生成）
#   ⚠️ deploy/.env.prod 含数据库口令、SECRET_KEY、AI key、S3 密钥，
#      **绝不提交仓库**（deploy/.gitignore 已忽略 .env.prod；发布前 `git status` 复查）。
#
# 生成密钥：
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"   # SECRET_KEY
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"   # PG 口令（urlsafe 字符可直接放进 DATABASE_URL）
#
# 本文件同时被两处读取，改动后要保证两边一致：
#   1) docker compose --env-file deploy/.env.prod 的插值（${POSTGRES_PASSWORD} 等）
#   2) 容器的 env_file: .env.prod（注入 backend / postgres 进程）
# =============================================================================

# -----------------------------------------------------------------------------
# 一、Compose 编排参数（只给 docker compose 用，不进应用）
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=sakura-gallery
# 对外 HTTP 端口；80 被占用时改 8080 之类，TLS 由宿主机 Caddy/certbot 处理
HTTP_PORT=80
TZ=Asia/Shanghai

# 数据库容器初始化参数（首次启动时生效；建库后改这里不会改已有库口令）
POSTGRES_USER=sakura
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=sakura_gallery

# 容器内存上限（2c4g 默认值，见 docs/DEPLOY_2C4G.md §5；一般不用改）
# PG_MEM_LIMIT=1024m
# BACKEND_MEM_LIMIT=768m
# NGINX_MEM_LIMIT=64m

# -----------------------------------------------------------------------------
# 二、应用基础
# -----------------------------------------------------------------------------
APP_NAME=视觉百花
APP_VERSION=1.0.0
# 生产必须 false：DEBUG=true 会打印详细堆栈并放宽校验
DEBUG=false

# -----------------------------------------------------------------------------
# 三、数据库连接
#   - 容器网络内主机名固定为 postgres（compose 服务名），不是 127.0.0.1
#   - 口令必须与上面 POSTGRES_PASSWORD 一致；actions.token_urlsafe 生成的字符
#     （A-Za-z0-9_-）无需转义，若手工用含 @ : / ? # % 的口令，必须 URL 编码：
#       python3 -c "import urllib.parse; print(urllib.parse.quote('你的口令', safe=''))"
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://sakura:CHANGE_ME_db_password@postgres:5432/sakura_gallery

# -----------------------------------------------------------------------------
# 四、安全（登录 JWT）
# -----------------------------------------------------------------------------
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# 启动脚本会拒绝 CHANGE_ME / 短于 32 字符的值（DEBUG=false 时）
SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_urlsafe_64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# 五、文件存储
#   local：原图/变体落 uploads 数据卷，由后端 /api/v1/photos/{id}/image/* 输出。
#          单机最省事，但图片流量走 Python worker（2 vCPU 上高并发图片浏览会吃 CPU）。
#   s3   ：Cloudflare R2 / 阿里云 OSS / MinIO 等 S3 兼容存储，公网推荐——
#          图片可预签名直连对象存储，不经过后端。切换后历史本地文件仍在 uploads 卷。
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=20971520
# 上传时是否生成 320/640/1080/1600/2400 响应式变体（多 10 次编码，换按屏宽取图；小机器可关）
UPLOAD_GENERATE_VARIANTS=true
# 每个 worker 同时处理的原图数（进程内信号量）。24MP 单张峰值 RSS 约 +190MB；
# 2c4g 保持 1：两 worker 最多 2 张并发，其余排队，防止 cgroup OOM kill。
UPLOAD_PROCESS_CONCURRENCY=1

# --- STORAGE_BACKEND=s3 时取消注释并填写（Cloudflare R2 示例，见 docs §6）---
# S3_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_BUCKET=sakura-gallery
# S3_ACCESS_KEY=CHANGE_ME_r2_access_key_id
# S3_SECRET_KEY=CHANGE_ME_r2_secret_access_key
# S3_REGION=auto
# S3_USE_SSL=true
# 腾讯 COS / 阿里 OSS 用 virtual；本机 MinIO 保持 auto
# S3_ADDRESSING_STYLE=virtual
# S3_PRESIGN_EXPIRE_SECONDS=600

# -----------------------------------------------------------------------------
# 六、AI 渠道（统一 OpenAI 兼容 HTTP 接口，2c4g 只调 API，不装 torch/GPU）
#   默认 AI_ENABLED=false：模板里没有真实 key，先让站点跑起来；
#   配好 OPENAI_COMPATIBLE_* 后改 true，审核与 Agent 检索才会真正调用模型。
#   AI_ENABLED=false 时：审核降级为「规则前置 + 人工队列」，检索固定 fast 模式。
# -----------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=openai_compatible
AI_TIMEOUT=60
AI_MAX_RETRIES=2
OPENAI_COMPATIBLE_BASE_URL=CHANGE_ME_https://your-openai-compatible-gateway/v1
OPENAI_COMPATIBLE_API_KEY=CHANGE_ME_ai_gateway_key
# 可选：渠道侧的模型映射 id（一般留空，由下面两个场景模型直接指定）
OPENAI_COMPATIBLE_MODEL_ID=

# 场景默认模型（与 backend/.env.example 保持一致）
AI_VISION_MODEL=qwen3-vl-plus
AI_TEXT_MODEL=deepseek-v4.1-flash-1017

# 旧 Ollama 配置（保留兼容，默认不用；2c4g 不跑本地模型）
# OLLAMA_API_URL=http://localhost:11434
# AI_MODEL_NAME=llava
# AI_MODEL_ID=llava
# AI_DAILY_BUDGET=500

# -----------------------------------------------------------------------------
# 七、Agent 审核（规则前置 → VLM 快筛 → 难例复核 → 人工终判）
# -----------------------------------------------------------------------------
MODERATION_ENABLED=true
# 留空 = 跟随 AI_VISION_MODEL / AI_TEXT_MODEL
MODERATION_PREFILTER_MODEL=
MODERATION_ESCALATION_MODEL=
MODERATION_PREFILTER_MAX_TOKENS=1024
# 推理模型给小了会被思维链吃光而截断，保持 ≥2048
MODERATION_ESCALATION_MAX_TOKENS=3072
MODERATION_ESCALATION_CONFIDENCE=0.6
MODERATION_AUTO_APPROVE_CONFIDENCE=0.8
MODERATION_AUTO_APPROVE_L0=true
# 日调用熔断：公网暴露后防刷/防成本失控（0 = 不限）；超出后降级为规则+人工
MODERATION_DAILY_CALL_BUDGET=2000
MODERATION_RETRY=2
MODERATION_AUTO_TAGGING=true
AUTO_TAGGING_MAX_TAGS=6

# ---- 审核队列持久化 / 内嵌 worker ----
# durable：入队即写 moderation_reviews(status=queued)，进程重启/崩溃后 worker 仍会兜底
# inline ：只走 BackgroundTasks（旧行为，重启会丢任务）
MODERATION_QUEUE_MODE=durable
MODERATION_WORKER_EMBEDDED=true          # 在 API 进程内轮询队列（多 uvicorn worker 下用 SKIP LOCKED 保证不重复领取）
MODERATION_WORKER_POLL_SECONDS=5         # 轮询间隔（秒）
MODERATION_WORKER_BATCH=3                # 每轮最多领取条数
MODERATION_WORKER_STALE_SECONDS=900      # running 超过该时长视为崩溃，回收重跑
MODERATION_DUPLICATE_HAMMING=5

# -----------------------------------------------------------------------------
# 八、Agent 驱动图片检索（PG pg_trgm + tsvector，无向量库）
# -----------------------------------------------------------------------------
AGENT_SEARCH_ENABLED=true
AGENT_SEARCH_MODEL=
AGENT_SEARCH_MAX_STEPS=4
# 端到端预算；超时自动回退确定性中文解释，不返回 500
AGENT_SEARCH_TIMEOUT=20
AGENT_SEARCH_EXPLAIN=true
AGENT_SEARCH_CLARIFY_ENABLED=true
AGENT_SEARCH_TRACE_ENABLED=true
AGENT_SEARCH_DAILY_CALL_BUDGET=2000
AGENT_SEARCH_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# 九、队列与向量检索：2c4g 明确不启用
#   后台任务用进程内 BackgroundTasks + DB outbox；不要设 celery（会需要 Redis）。
# -----------------------------------------------------------------------------
TASK_QUEUE_BACKEND=background
# REDIS_URL=redis://localhost:6379/0
# 2c4g 不装 Milvus/torch，以下保持默认即可（不要取消注释）
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# -----------------------------------------------------------------------------
# 十、CORS：填前端站点的公网地址（JSON 数组，必须是合法 JSON 字符串）
#   已启用 HTTPS 就只写 https；同域相对路径部署时前端请求不触发 CORS，
#   但后端 CORS 中间件仍会校验，按实际域名配置最稳。
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS='["https://sakura.example.com","http://sakura.example.com"]'

# -----------------------------------------------------------------------------
# 十一、可选：国内服务器构建加速（改镜像源后取消注释；不填用官方源）
# -----------------------------------------------------------------------------
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com

# -----------------------------------------------------------------------------
# 十二、可选：数据库连接池（默认 10/20/1800）
#   真实连接数 = uvicorn workers × (DB_POOL_SIZE + DB_POOL_MAX_OVERFLOW)
#   默认 2 × 30 = 60，小于 compose 里 PG 的 max_connections=80；PG 内存偏紧时降 DB_POOL_SIZE
# -----------------------------------------------------------------------------
# DB_POOL_SIZE=10
# DB_POOL_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800

# -----------------------------------------------------------------------------
# 十三、可选：uvicorn / 转发相关（compose environment 已给默认值，改在这里会被覆盖）
#   UVICORN_WORKERS=2
#   UVICORN_LIMIT_MAX_REQUESTS=10000
#   FORWARDED_ALLOW_IPS=*
#   DB_WAIT_ATTEMPTS=60
#   MIGRATE_ATTEMPTS=3
# -----------------------------------------------------------------------------

# 对外站点地址（sitemap/robots/OG 用，不含结尾斜杠）
SITE_BASE_URL=https://buct-sakura.cn
