# =============================================================================
# 视觉百花 Sakura Gallery — 前端生产镜像（Vite 多阶段构建 → nginx 托管）
# -----------------------------------------------------------------------------
# 构建上下文是**仓库根**（不是 frontend/）：需要同时拿到 frontend/ 源码与
# deploy/nginx.prod.conf。deploy/Dockerfile.frontend.dockerignore 用白名单只放行
# 这两个目录，避免 351MB node_modules / 889MB uploads / .git 进上下文。
#
# 手工构建（在仓库根执行）：
#   docker build -f deploy/Dockerfile.frontend \
#     -t sakura-gallery-frontend:latest \
#     --build-arg NPM_REGISTRY=https://registry.npmjs.org .
#
# 说明：生产镜像不需要 VITE_API_BASE_URL —— frontend/.env.production 已把它留空，
# 前端用相对路径 /api/v1 请求，由同镜像的 nginx 反代到 backend 容器。
# =============================================================================
# 基础镜像 ARG 必须声明在**第一个 FROM 之前**，否则后续 FROM 里引用会报
# "base name (${NGINX_IMAGE}) should not be blank"（Docker 的 ARG/FROM 作用域规则）。
ARG NODE_IMAGE=node:22-alpine
ARG NGINX_IMAGE=nginx:1.27-alpine

# -----------------------------------------------------------------------------
# 阶段 1：构建 Vite 产物
# -----------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS build

ARG NPM_REGISTRY=https://registry.npmjs.org

WORKDIR /src

# 2c4g 构建时限制 Node 堆上限，避免 tsc/vite 峰值把整机 OOM（有 swap 兜底）
ENV NODE_OPTIONS=--max-old-space-size=1536 \
    CI=true

# 先拷 lock 文件：依赖没变时 npm ci 层命中缓存，改代码不用重装依赖
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --registry "${NPM_REGISTRY}" --no-audit --no-fund

# 再拷源码（.env.production 决定 VITE_API_BASE_URL 为空 = 相对路径）
COPY frontend/ ./
RUN npm run build && test -f dist/index.html

# -----------------------------------------------------------------------------
# 阶段 2：nginx 托管静态产物
# -----------------------------------------------------------------------------
FROM ${NGINX_IMAGE} AS runtime

LABEL org.opencontainers.image.title="sakura-gallery-frontend" \
      org.opencontainers.image.description="视觉百花 Sakura Gallery 前端（Vite 构建产物 + 生产 nginx）" \
      org.opencontainers.image.source="https://github.com/visual-buct/sakura-gallery" \
      org.opencontainers.image.vendor="Sakura Gallery" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="1.0.0"

# 覆盖官方镜像自带的默认站点；其余 nginx 全局配置保持官方默认（含 /etc/nginx/conf.d/*.conf include）
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html

EXPOSE 80

# 与 deploy/docker-compose.prod.yml 的 healthcheck 保持一致（compose 里会覆盖此值）
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1

# 保留官方 entrypoint（/docker-entrypoint.sh 处理模板后启动 nginx）：
# master 以 root 起、worker 自动降为 nginx 用户，符合官方镜像的默认安全模型。
CMD ["nginx", "-g", "daemon off;"]
