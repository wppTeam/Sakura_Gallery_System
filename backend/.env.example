# 应用配置
APP_NAME=视觉北化
APP_VERSION=1.0.0
DEBUG=True

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./visual_buct.db

# 文件存储配置
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=20971520

# S3/MinIO 对象存储配置 (STORAGE_BACKEND=s3 时需要)
S3_ENDPOINT=http://127.0.0.1:19000
S3_BUCKET=buctmedia
S3_ACCESS_KEY=admin
S3_SECRET_KEY=your-secret-key-here
S3_REGION=
S3_USE_SSL=False
S3_PRESIGN_EXPIRE_SECONDS=600

# 安全配置
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI 服务配置（统一走 OpenAI 兼容接口，httpx 直连，无需 torch）
AI_ENABLED=True
AI_PROVIDER=openai_compatible            # ollama | dashscope | openai_compatible
AI_TIMEOUT=60
AI_MAX_RETRIES=2

# OpenAI 兼容渠道（本地 magpie / 中转站 / 百炼 compatible-mode 均可）
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_COMPATIBLE_API_KEY=your-key-here
OPENAI_COMPATIBLE_MODEL_ID=

# 场景默认模型
AI_VISION_MODEL=qwen3-vl-plus            # 审核快筛 / 读图
AI_TEXT_MODEL=deepseek-v4.1-flash-1017   # 推理 / 难例复核 / 意图解析（推理型，max_tokens 需 ≥2048）

# 旧 Ollama 配置（保留兼容，默认不用）
OLLAMA_API_URL=http://localhost:11434
AI_MODEL_NAME=llava
AI_MODEL_ID=llava
AI_DAILY_BUDGET=500

# Agent 审核（规则前置 → VLM 快筛 → 难例复核 → 人工终判）
MODERATION_ENABLED=True
MODERATION_PREFILTER_MODEL=              # 空 → AI_VISION_MODEL
MODERATION_ESCALATION_MODEL=             # 空 → AI_TEXT_MODEL
MODERATION_PREFILTER_MAX_TOKENS=1024
MODERATION_ESCALATION_MAX_TOKENS=3072
MODERATION_ESCALATION_CONFIDENCE=0.6
MODERATION_AUTO_APPROVE_CONFIDENCE=0.8
MODERATION_AUTO_APPROVE_L0=True
MODERATION_DAILY_CALL_BUDGET=0           # 0 = 不限流
MODERATION_RETRY=2
MODERATION_DUPLICATE_HAMMING=5

# Agent 驱动图片检索（PG pg_trgm + tsvector，无向量库）
AGENT_SEARCH_ENABLED=True
AGENT_SEARCH_MODEL=                      # 空 → AI_TEXT_MODEL
AGENT_SEARCH_MAX_STEPS=4
AGENT_SEARCH_TIMEOUT=20
AGENT_SEARCH_EXPLAIN=True
AGENT_SEARCH_CLARIFY_ENABLED=True
AGENT_SEARCH_TRACE_ENABLED=True
AGENT_SEARCH_DAILY_CALL_BUDGET=0         # 0 = 不限流
AGENT_SEARCH_LIMIT_MAX=100

# 旧向量检索（默认关闭，2c4g 不装 Milvus / torch）
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=photo_vectors_v2
MILVUS_EMBEDDING_DIM=512

# CORS 配置
ALLOWED_ORIGINS='["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]'
